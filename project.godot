; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Masque Prototype (working title)"
config/description="First-person high-speed horror roguelite prototype. Vertical slice in progress."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
GameState="*res://autoload/game_state.gd"
TimeDirector="*res://autoload/time_director.gd"
AudioDirector="*res://autoload/audio_director.gd"
RunManager="*res://autoload/run_manager.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

